# ===================================================================
# SLM Assistant v3 - Environment Configuration (ONE .env file, root
# only - both apps/api and the docker-compose services read from
# this file; see prisma.config.ts / app.module.ts for how apps/api
# locates it two directories up from its own working directory).
# ===================================================================

# --- App ---
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=4000

# --- Database (Postgres, via docker-compose locally) ---
DATABASE_URL=postgresql://slm:slm@localhost:5432/slm

# --- Vector store (Chroma, via docker-compose locally) ---
CHROMA_URL=http://localhost:8000

# --- Auth ---
# Access tokens are short-lived JWTs signed with this secret. Refresh
# tokens are opaque random values stored hashed in Postgres (no secret
# needed for those - the DB row IS the source of truth for validity).
# Generate a fresh one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=REPLACE_ME

# Comma-separated list of Google account emails that get auto-promoted
# to ADMIN the first time they log in. No manual DB edits needed.
ADMIN_EMAILS=you@example.com

# --- Google OAuth (Login) ---
# Create your OWN OAuth client at console.cloud.google.com -> APIs &
# Services -> Credentials -> Create Credentials -> OAuth client ID
# (type: Web application). Add this Authorized redirect URI:
#   http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Provider-key vault encryption ---
# AES-256-GCM master key, base64, must decode to exactly 32 bytes.
# Generate a fresh one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME
